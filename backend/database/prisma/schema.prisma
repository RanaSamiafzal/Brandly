generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id                    String                 @id @default(uuid())
  fullname              String
  email                 String                 @unique
  password              String
  roleId                String
  isVerified            Boolean                @default(false)
  isBlocked             Boolean                @default(false)
  refreshToken          String?
  profilePic            String?
  coverPic              String?
  googleId              String?
  isGoogleUser          Boolean                @default(false)
  resetOtp              String?
  resetOtpExpires       DateTime?
  passwordResetAttempts Int                    @default(0)
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  activities            Activity[]
  brandProfile          BrandProfile?
  receivedRequests      CollaborationRequest[] @relation("Receiver")
  sentRequests          CollaborationRequest[] @relation("Sender")
  influencerProfile     InfluencerProfile?
  role                  Role                   @relation(fields: [roleId], references: [id])
  messages              Message[]

  @@index([email])
  @@index([roleId])
}

model BrandProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  brandName   String
  industry    String     @default("")
  website     String?    @default("")
  address     String?    @default("")
  description String?    @default("")
  logo        String?    @default("")
  budgetMin   Float?
  budgetMax   Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  campaigns   Campaign[]

  @@index([userId])
}

model InfluencerProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  username      String       @unique
  about         String       @default("")
  category      String       @default("")
  location      String       @default("")
  portfolio     String?      @default("")
  averageRating Float        @default(0)
  isAvailable   Boolean      @default(true)
  platforms     Json         @default("[]")
  phone         String?      @default("")
  website       String?      @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  matchScores   MatchScore[]

  @@index([userId])
  @@index([category])
}

model Campaign {
  id                     String                 @id @default(uuid())
  brandId                String
  title                  String
  description            String                 @default("")
  image                  String?                @default("")
  budgetMin              Float                  @default(0)
  budgetMax              Float                  @default(0)
  targetCategory         String[]
  targetPlatform         String[]
  campaignTimeline       String?
  deliverables           String
  targetAudience         String
  additionalRequirements String?                @default("")
  resources              Json                   @default("[]")
  status                 String                 @default("ACTIVE")
  isDeleted              Boolean                @default(false)
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  analytics              Analytics[]
  brand                  BrandProfile           @relation(fields: [brandId], references: [id])
  requests               CollaborationRequest[]
  matchScores            MatchScore[]

  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

model CollaborationRequest {
  id             String    @id @default(uuid())
  campaignId     String
  senderId       String
  receiverId     String
  proposedBudget Float?
  note           String?   @default("")
  status         String    @default("PENDING")
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  campaign       Campaign  @relation(fields: [campaignId], references: [id])
  receiver       User      @relation("Receiver", fields: [receiverId], references: [id])
  sender         User      @relation("Sender", fields: [senderId], references: [id])
  messages       Message[]
  tasks          CampaignTask[]

  @@unique([senderId, receiverId, campaignId])
  @@index([campaignId])
  @@index([senderId])
  @@index([receiverId])
}

model Activity {
  id          String   @id @default(uuid())
  userId      String
  role        String   @default("BRAND")
  type        String
  title       String
  description String?  @default("")
  relatedId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model MatchScore {
  id           String            @id @default(uuid())
  campaignId   String
  influencerId String
  score        Float
  breakdown    Json
  createdAt    DateTime          @default(now())
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id])

  @@unique([campaignId, influencerId])
  @@index([campaignId])
  @@index([influencerId])
}

model Analytics {
  id         String   @id @default(uuid())
  campaignId String
  metric     String
  value      Float
  date       DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Payment {
  id        String   @id @default(uuid())
  amount    Float
  status    String
  type      String
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String               @id @default(uuid())
  requestId  String
  senderId   String
  content    String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  request    CollaborationRequest @relation(fields: [requestId], references: [id])
  sender     User                 @relation(fields: [senderId], references: [id])

  @@index([requestId])
  @@index([senderId])
}

model CampaignTask {
  id          String               @id @default(uuid())
  requestId   String
  title       String
  description String?              @default("")
  status      String               @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  request     CollaborationRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}
